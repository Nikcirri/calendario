<?xml version="1.0" encoding="utf-8"?>
<!-- Casella di un'ora nella colonna di oggi: riga in alto e un velo del colore d'accento -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_today_tint" />
        </shape>
    </item>
    <item
        android:height="1dp"
        android:gravity="top">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_line" />
        </shape>
    </item>
</layer-list>
