<?xml version="1.0" encoding="utf-8"?>
<!--
  Casella di un'ora nella griglia del widget Settimana: una riga sottile in fondo (è la riga dell'ora dopo).
  Sta in fondo e non in cima apposta: così i pezzi di un blocco lungo, disegnati dopo, la coprono del tutto
  anche quando la schermata Home rimpicciolisce il widget (vedi widget_week_block.xml).
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:height="1dp"
        android:gravity="bottom">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_line" />
        </shape>
    </item>
</layer-list>
