<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget "Settimana": titolo, + per un nuovo evento e sotto le sette colonne dei giorni
  (aggiunte dal codice dentro week_days). Solo viste ammesse nei widget.
  Le misure in dp devono restare uguali alle costanti di WeekWidget.java.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/week_header"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/week_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:paddingStart="4dp"
            android:text="@string/widget_week_name"
            android:textColor="@color/widget_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/week_add"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_btn_accent"
            android:contentDescription="@string/widget_add"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="+"
            android:textColor="@color/widget_on_accent"
            android:textSize="20sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/week_days"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="2dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Testo dell'anteprima: sparisce appena il widget viene disegnato con i giorni veri. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/widget_week_preview"
            android:textColor="@color/widget_muted"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
