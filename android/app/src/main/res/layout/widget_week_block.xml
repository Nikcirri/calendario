<?xml version="1.0" encoding="utf-8"?>
<!--
  Pezzo di un blocco nella griglia delle ore: sfondo colorato dal codice e titolo sopra.
  L'altezza la decide il codice (sul testo). Per i promemoria si accende block_edge: lo sfondo colorato
  resta visibile solo come bordo, come nell'app.

  Le strisce "join" si accendono sui lati dove il blocco continua nell'ora prima o dopo. Sporgono di 2dp
  oltre il pezzo (margine negativo) e ripassano il colore più volte (widget_block_join.xml).
  Servono sulle schermate Home che disegnano i widget un po' rimpiccioliti (Samsung): lì il bordo tra due
  righe della lista cade a metà pixel e Android lo sfuma, quindi tra un pezzo e l'altro di un blocco lungo
  si vedrebbe una riga sottile più scura. La prova weekHoursBlocksAreSeamlessWhenScaled lo controlla.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/block_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_block" />

    <ImageView
        android:id="@+id/block_join_top"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_gravity="top"
        android:layout_marginTop="-2dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_block_join"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/block_join_bottom"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="-2dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_block_join"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/block_edge"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <ImageView
            android:id="@+id/block_fill"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/widget_block" />

        <ImageView
            android:id="@+id/block_fill_top"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_gravity="top"
            android:layout_marginTop="-2dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/widget_block_join"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/block_fill_bottom"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_gravity="bottom"
            android:layout_marginBottom="-2dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/widget_block_join"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/block_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:breakStrategy="simple"
        android:hyphenationFrequency="none"
        android:includeFontPadding="false"
        android:paddingStart="2dp"
        android:paddingTop="@dimen/widget_block_pad"
        android:textColor="#FFFFFFFF"
        android:textSize="@dimen/widget_block_text" />
</FrameLayout>
